-- 🎯 แบบที่ 1: ระบบล็อคตัวผู้เล่น (Target Lock)
-------------------------------------------------
local LockTab = Window:CreateTab("🎯 ล็อคตัวผู้เล่น (Option 1)", 4483362458)

local TargetLockEnabled = false
local LockTarget = nil
local MaxDistance = 500

-- ฟังก์ชันหาผู้เล่นใกล้ที่สุด
local function GetClosestPlayer()
    local closestPlayer = nil
    local shortestDistance = MaxDistance
    local localPlayer = game.Players.LocalPlayer
    local localChar = localPlayer.Character
    
    if localChar and localChar:FindFirstChild("HumanoidRootPart") then
        local myPos = localChar.HumanoidRootPart.Position
        
        for _, player in pairs(game.Players:GetPlayers()) do
            if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChildOfClass("Humanoid") then
                if player.Character.Humanoid.Health > 0 then
                    local targetPos = player.Character.HumanoidRootPart.Position
                    local distance = (targetPos - myPos).Magnitude
                    
                    if distance < shortestDistance then
                        shortestDistance = distance
                        closestPlayer = player
                    end
                end
            end
        end
    end
    return closestPlayer
end

-- ลูปรันระบบล็อคมุมกล้องหันตามตัวผู้เล่น
game:GetService("RunService").RenderStepped:Connect(function()
    if TargetLockEnabled then
        if not LockTarget or not LockTarget.Character or LockTarget.Character.Humanoid.Health <= 0 then
            LockTarget = GetClosestPlayer()
        end
        
        if LockTarget and LockTarget.Character and LockTarget.Character:FindFirstChild("HumanoidRootPart") then
            local camera = workspace.CurrentCamera
            camera.CFrame = CFrame.new(camera.CFrame.Position, LockTarget.Character.HumanoidRootPart.Position)
        end
    end
end)

-- ปุ่มเปิด/ปิด แบบที่ 1
LockTab:CreateToggle({
