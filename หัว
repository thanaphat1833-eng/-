-- ลูปการทำงานของ Option 5 (Teleport & Hit)
task.spawn(function()
    while task.wait(0.1) do
        if LockTarget and LockTarget.Character and LockTarget.Character:FindFirstChild("HumanoidRootPart") then
            local myChar = game.Players.LocalPlayer.Character
            
            -- วาร์ปไปข้างหลังเป้าหมาย 3 ช่อง
            if TeleportToTargetEnabled and myChar and myChar:FindFirstChild("HumanoidRootPart") then
                local targetHRP = LockTarget.Character.HumanoidRootPart
                myChar.HumanoidRootPart.CFrame = targetHRP.CFrame * CFrame.new(0, 0, 3)
            end
            
            -- สั่งจำลองการคลิกโจมตี
            if AutoHitEnabled then
                local virtualUser = game:GetService("VirtualUser")
                virtualUser:CaptureController()
                virtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            end
        end
    end
end)

