-- ฟังก์ชันค้นหาจุดสีเขียว
local function getGreenZone()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Color == Color3.fromRGB(0, 255, 0) 
               or obj.Color == Color3.fromRGB(85, 255, 0) 
               or (obj.BrickColor and obj.BrickColor.Name:lower():find("green")) then
                return obj
            end
        end
    end
    return nil
end

-- ลูปการทำงาน (รับกล่อง -> วาร์ปไปจุดเขียว)
task.spawn(function()
    while true do
        task.wait(0.3)
        if _G.AutoBoxTP then
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            
            if hrp then
                -- 1. ไปกดรับกล่องที่ ProximityPrompt
                local foundBox = false
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        -- วาร์ปไปหากล่อง
                        hrp.CFrame = prompt.Parent:GetPivot() * CFrame.new(0, 0, -2)
                        task.wait(0.2)
                        fireproximityprompt(prompt)
                        task.wait(0.3)
                        foundBox = true
                        break
                    end
                end
                
                -- 2. วาร์ปไปจุดสีเขียวส่งของ
                if foundBox then
                    local greenZone = getGreenZone()
                    if greenZone then
                        hrp.CFrame = greenZone.CFrame * CFrame.new(0, 3, 0)
                        task.wait(1) -- รอเวลาให้ระบบคิดเงิน/ส่งกล่อง
                    end
                end
            end
        end
    end
end)
