-- ฟังก์ชันค้นหาจุดสีเขียวส่งของ
local function getGreenZoneCFrame()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            if obj.Color == Color3.fromRGB(0, 255, 0) 
               or obj.Color == Color3.fromRGB(85, 255, 0)
               or (obj.BrickColor and obj.BrickColor.Name:lower():find("green"))
               or obj.Name:lower():find("sell") 
               or obj.Name:lower():find("drop") then
                return obj.CFrame
            end
        end
    end
    return nil
end

-- ฟังก์ชันวาร์ป
local function tpToGreenZone()
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local greenCFrame = getGreenZoneCFrame()
        if greenCFrame then
            char.HumanoidRootPart.CFrame = greenCFrame * CFrame.new(0, 3, 0)
        end
    end
end

