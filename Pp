-- Loop การทำงานของ Auto Farm
task.spawn(function()
    while true do
        task.wait(0.5)
        if _G.AutoBoxFarm then
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                -- กดรับกล่อง
                for _, prompt in pairs(workspace:GetDescendants()) do
                    if prompt:IsA("ProximityPrompt") then
                        char.HumanoidRootPart.CFrame = prompt.Parent:GetPivot() * CFrame.new(0, 0, -3)
                        task.wait(0.2)
                        fireproximityprompt(prompt)
                        task.wait(0.4)
                        break
                    end
                end
                
                -- วาร์ปไปส่งที่จุดสีเขียว
                tpToGreenZone()
            end
        end
    end
end)

